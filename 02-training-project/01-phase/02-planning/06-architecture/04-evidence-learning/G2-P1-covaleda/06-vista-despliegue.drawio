        </mxCell>
        <mxCell id="art_backend" value="«artifact»&lt;br&gt;&lt;b&gt;Contenedor Docker: Backend NestJS&lt;/b&gt;&lt;hr&gt;• Runtime Node.js 20+ LTS (Port 3000)&lt;br&gt;• Módulos Auth, Catalogo, Cupones, POS&lt;br&gt;• CanjeCuponFacade &amp; Token HMAC&lt;br&gt;• Servidor WebSockets WSS Notificaciones" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=10;" vertex="1" parent="node_app">
