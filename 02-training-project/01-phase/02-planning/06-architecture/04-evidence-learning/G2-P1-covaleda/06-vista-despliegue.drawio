        <mxCell id="hdr_desp" value="NUVORA — VISTA DE DESPLIEGUE FÍSICO Y DE RED (UML DEPLOYMENT DIAGRAM)&#xa;Guía 2 · Producto 1 (G2-P1) · RAP 593103 (Criterio C6) · Autor: Jose Esneider Covaleda (covaleda402) · Protocolos y Puertos" style="text;html=1;strokeColor=#1E3A8A;fillColor=#DBEAFE;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;" vertex="1" parent="1">
