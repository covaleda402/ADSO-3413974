        <mxCell id="art_pwa" value="«artifact»&lt;br&gt;&lt;b&gt;PWA Visitante (Browser)&lt;/b&gt;&lt;hr&gt;• UI Mobile-First Responsive&lt;br&gt;• Service Worker (Cache offline)&lt;br&gt;• LocalStorage (JWT Bearer Token)&lt;br&gt;• Canvas QR &amp; Reloj Regresivo 2h" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=10;" vertex="1" parent="node_cli">
