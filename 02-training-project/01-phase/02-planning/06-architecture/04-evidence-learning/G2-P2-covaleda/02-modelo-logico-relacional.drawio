        <mxCell id="tab_cupon" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;fillColor=#ecfdf5;strokeColor=#16a34a;strokeWidth=1.8;fontSize=11;fontFamily=Segoe UI;fontColor=#0f172a;" value="&lt;p style=&quot;margin:0px;text-align:center;font-weight:bold;font-size:12px;color:#15803d;&quot;&gt;&amp;lt;&amp;lt;associative N:M&amp;gt;&amp;gt; cupon&lt;/p&gt;&lt;hr style=&quot;border-top:1.5px solid #16a34a;margin:4px 0px;&quot;/&gt;&lt;b&gt;[PK] id_cupon: BIGSERIAL&lt;/b&gt;&lt;hr style=&quot;border-top:1px dashed #cbd5e1;margin:4px 0px;&quot;/&gt;&lt;i&gt;[FK] id_usuario_visitante: BIGINT [NN]&lt;/i&gt;&lt;br/&gt;&lt;i&gt;[FK] id_promocion: BIGINT [NN]&lt;/i&gt;&lt;br/&gt;codigo_alfanumerico: VARCHAR(8) [NN, UQ]&lt;br/&gt;token_dinamico_hash: VARCHAR(255) [NN]&lt;br/&gt;estado_canje: VARCHAR(20) [NN, CHK]&lt;br/&gt;fecha_hora_emision: TIMESTAMPTZ [NN]&lt;br/&gt;fecha_hora_expiracion: TIMESTAMPTZ [NN, CHK]" vertex="1">
          <mxGeometry height="225" width="305" x="100" y="455" as="geometry" />
        </mxCell>
        <mxCell id="tab_bitacora" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=1.8;fontSize=11;fontFamily=Segoe UI;fontColor=#0f172a;" value="&lt;p style=&quot;margin:0px;text-align:center;font-weight:bold;font-size:12px;color:#e11d48;&quot;&gt;bitacora_canje&lt;/p&gt;&lt;hr style=&quot;border-top:1.5px solid #e11d48;margin:4px 0px;&quot;/&gt;&lt;b&gt;[PK] id_canje: BIGSERIAL&lt;/b&gt;&lt;hr style=&quot;border-top:1px dashed #cbd5e1;margin:4px 0px;&quot;/&gt;&lt;i&gt;[FK] id_cupon: BIGINT [NN, UQ 1:1]&lt;/i&gt;&lt;br/&gt;&lt;i&gt;[FK] id_usuario_cajero: BIGINT [NN]&lt;/i&gt;&lt;br/&gt;&lt;i&gt;[FK] id_local: INT [NN]&lt;/i&gt;&lt;br/&gt;fecha_hora_canje: TIMESTAMPTZ [NN]&lt;br/&gt;monto_descuento_aplicado: NUMERIC(12,2) [CHK]&lt;br/&gt;numero_factura_pos: VARCHAR(50) [NN]&lt;br/&gt;ip_origen_terminal: VARCHAR(45) [NN]&lt;br/&gt;firma_hash_transaccion: VARCHAR(255) [NN]" vertex="1">
          <mxGeometry height="245" width="320" x="92.5" y="775" as="geometry" />
        </mxCell>
        <mxCell id="note_tech" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;fontSize=11;fontFamily=Segoe UI;fontColor=#1e293b;" value="&lt;b style=&quot;font-size:12px;color:#0f172a;&quot;&gt;Convenciones Técnicas del Modelo Lógico Relacional en 3FN (Rúbrica G2-P2 · Criterio 2):&lt;/b&gt;&lt;hr style=&quot;border-top:1px solid #cbd5e1;margin:5px 0px;&quot;/&gt;• &lt;b&gt;Notación Pata de Gallo (Crow&#39;s Foot):&lt;/b&gt; Estándar ANSI SQL para PostgreSQL 15+ — &lt;b&gt;10 tablas / 64 columnas / 13 claves foráneas / 16 CHECKs / 5 UNIQUEs&lt;/b&gt;.&lt;br/&gt;• &lt;b&gt;Resolución N:M:&lt;/b&gt; &lt;code&gt;cupon&lt;/code&gt; (Usuario ↔ Promoción con código, token, fechas y estado) y &lt;code&gt;promocion_producto&lt;/code&gt; (Promoción ↔ Producto).&lt;br/&gt;• &lt;b&gt;Atributo Multivaluado (1FN):&lt;/b&gt; &lt;code&gt;preferencia_visitante&lt;/code&gt; extrae &lt;code&gt;preferencias_gastronomicas [*]&lt;/code&gt; con PK compuesta &lt;code&gt;(id_usuario, categoria_preferida)&lt;/code&gt;.&lt;br/&gt;• &lt;b&gt;Normalización 3FN:&lt;/b&gt; &lt;code&gt;categoria_comercio&lt;/code&gt; elimina dependencias transitivas financieras de los locales; &lt;code&gt;bitacora_canje&lt;/code&gt; aisla el cobro 1:1 con &lt;code&gt;id_cupon UNIQUE&lt;/code&gt;.&lt;br/&gt;• &lt;b&gt;Entidad Débil:&lt;/b&gt; &lt;code&gt;franja_horaria&lt;/code&gt; depende en identidad y existencia de &lt;code&gt;promocion&lt;/code&gt; (&lt;code&gt;ON DELETE CASCADE&lt;/code&gt;).&lt;br/&gt;• &lt;b&gt;Acciones Referenciales:&lt;/b&gt; &lt;code&gt;ON DELETE RESTRICT&lt;/code&gt; en catálogos y bitácoras; &lt;code&gt;ON DELETE CASCADE&lt;/code&gt; en preferencias, franjas y vínculo de oferta." vertex="1">
          <mxGeometry height="225" width="1085" x="465" y="795" as="geometry" />
        </mxCell>
